+bool Context::ConsumeInputEdit(const string& old_input, uint64_t old_epoch,
+                               InputEdit* result) {
+  InputEdit edit = std::move(input_edit_);
+  input_edit_ = InputEdit();
+  if (!result || !edit.valid || edit.old_input != old_input ||
+      edit.old_epoch != old_epoch || edit.new_input != input_ ||
+      edit.new_epoch != composition_epoch_ || edit.start > edit.old_end ||
+      edit.old_end > edit.old_input.size()) return false;
+  *result = std::move(edit);
+  return true;
+}
+
+void Context::NotifyUpdate() {
+  input_edit_ = InputEdit();
+  update_notifier_(this);
+}
+
+void Context::NotifyInputEdit(string old_input, size_t start, size_t old_end,
+                              uint64_t old_epoch) {
+  struct Scope {
+    InputEdit& slot;
+    InputEdit previous;
+    explicit Scope(InputEdit& s) : slot(s), previous(std::move(s)) {
+      previous.valid = false;
+    }
+    ~Scope() { slot = std::move(previous); }
+  } scope(input_edit_);
+  input_edit_ = {std::move(old_input), input_, start, old_end, old_epoch,
+                 composition_epoch_, true};
+  update_notifier_(this);
+}
